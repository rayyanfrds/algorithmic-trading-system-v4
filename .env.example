# ============================================================
# .env.example - Template Konfigurasi V4.0 Live Trading System
# ============================================================
# Copy file ini menjadi .env dan isi dengan nilai asli Anda.

# --- MetaTrader 5 Account ---
MT5_LOGIN=123456789          # Nomor akun MT5 Anda
MT5_PASSWORD=your_password   # Password trading (BUKAN investor password)
MT5_SERVER=BrokerName-Demo   # Nama server broker (contoh: Exness-MT5Trial14)

# --- Simbol Trading ---
# Gunakan nama simbol sesuai broker Anda
# Contoh Exness: XAUUSDm, BTCUSDm (demo) | XAUUSDc, BTCUSDc (cent real)
MT5_SYMBOL=XAUUSDm

# --- Telegram Bot (Opsional, untuk notifikasi) ---
# Buat bot via @BotFather di Telegram
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- FRED API Key (Opsional, untuk data makroekonomi) ---
# Daftar gratis di: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key
