# ============================================================
# .gitignore — V4 Meta-Trading Engine
# ============================================================

# --- Kredensial & Secrets (JANGAN PERNAH COMMIT) ---
.env
*.env
*.secret
*password*
*token*

# --- Cache Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# --- Virtual Environment ---
.venv/
venv/
env/
ENV/

# --- Data CSV/Parquet Besar (Jangan commit data mentah) ---
*.csv
*.parquet
!logs_sample/*.csv

# --- Model Binary (Opsional: jika besar, gunakan Git LFS atau exclude) ---
# *.pkl
# *.joblib
# *.onnx

# --- File Temporary & Output ---
scratch/
output/
*.log
*.tmp

# --- IDE & OS ---
.idea/
.vscode/
*.DS_Store
Thumbs.db

# --- Notebook Checkpoint ---
.ipynb_checkpoints/

# --- Distribusi Python ---
*.egg-info/
dist/
build/
